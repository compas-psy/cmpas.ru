{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "proxy-in",
      "listen": "0.0.0.0",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "hysteria2",
      "tag": "hysteria2-out",
      "server": "${HYSTERIA_SERVER}",
      "server_port": ${HYSTERIA_PORT},
      "password": "${HYSTERIA_PASSWORD}",
      "tls": {
        "enabled": true,
        "insecure": ${HYSTERIA_INSECURE},
        "server_name": "${HYSTERIA_SNI}"
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "protocol": "dns",
        "outbound": "direct"
      }
    ],
    "final": "hysteria2-out"
  }
}

# Общие настройки
PROJECT_NAME=cmpas.ru
VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# База данных
# Для разработки используется SQLite
DATABASE_URL=sqlite+aiosqlite:///./cmpas.db
# Для продакшена используйте PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/cmpas

# Безопасность
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username

# Яндекс ID OAuth
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
YANDEX_REDIRECT_URI=http://localhost:8000/api/auth/yandex/callback

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Email (для будущих уведомлений)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@cmpas.ru

# Логирование
LOG_LEVEL=INFO

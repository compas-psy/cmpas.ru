# Database
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/cmpas_db"

# Yandex OAuth (get from https://oauth.yandex.ru/)
YANDEX_CLIENT_ID="your-yandex-client-id"
YANDEX_CLIENT_SECRET="your-yandex-client-secret"

# Auth.js / NextAuth
# CRITICAL: Generate with `openssl rand -base64 32` and NEVER change after first deploy!
# Changing this value invalidates ALL existing user sessions.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
AUTH_URL="https://cmpas.ru"

# Email (Postfix mailer in Docker)
EMAIL_SERVER_HOST="mailer"
EMAIL_SERVER_PORT="25"
EMAIL_FROM="noreply@cmpas.ru"

# Telegram notifications
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"

# MAX Messenger Bot (mail.ru)
# Get token from MAX Partners: https://biz.mail.ru/max/
MAX_BOT_TOKEN="your-max-bot-token"
# Bot's MAX username — REQUIRED for client invite links (https://max.ru/<username>).
# Without it, buildDirectChannelLink('max', ...) returns null and MAX invites
# silently fall back to "MAX not configured" everywhere.
MAX_BOT_USERNAME="CompasProBot"
# Optional: separate HMAC secret for MAX connect links (defaults to AUTH_SECRET)
MAX_LINK_SECRET="generate-with-openssl-rand-base64-32"

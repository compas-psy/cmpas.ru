# Database
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/cmpas_db"

# Yandex OAuth (get from https://oauth.yandex.ru/)
YANDEX_CLIENT_ID="your-yandex-client-id"
YANDEX_CLIENT_SECRET="your-yandex-client-secret"

# Auth.js / NextAuth
# CRITICAL: Generate with `openssl rand -base64 32` and NEVER change after first deploy!
# Changing this value invalidates ALL existing user sessions.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
AUTH_URL="https://cmpas.ru"

# Email (Postfix mailer in Docker)
EMAIL_SERVER_HOST="mailer"
EMAIL_SERVER_PORT="25"
EMAIL_FROM="noreply@cmpas.ru"

# Telegram notifications
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"

# MAX Messenger Bot (mail.ru)
# Get token from MAX Partners: https://biz.mail.ru/max/
MAX_BOT_TOKEN="your-max-bot-token"
# Optional: separate HMAC secret for MAX connect links (defaults to AUTH_SECRET)
MAX_LINK_SECRET="generate-with-openssl-rand-base64-32"

# Tinkoff eAcquiring — site terminal (already required today, undocumented before)
TINKOFF_TERMINAL_KEY="your-site-terminal-key"
TINKOFF_PASSWORD="your-site-terminal-password"
# Optional second terminal for the app, charter/13_TRACKING_PLAN.md §1.
# Until both are set, webhook notifications from an app terminal are rejected.
TINKOFF_APP_TERMINAL_KEY="your-app-terminal-key"
TINKOFF_APP_PASSWORD="your-app-terminal-password"

# Analytics F0/F1 (charter/13_TRACKING_PLAN.md, charter/12_ANALYTICS.md) — both off by default.
ANALYTICS_TRACKING_ENABLED="false"
ANALYTICS_INGEST_ENABLED="false"
# Общий секрет POST /ingest (O-260817-17) — без него приёмник отказывает
# всем запросам, а не работает открытым.
ANALYTICS_INGEST_SECRET="generate-with-openssl-rand-hex-32"

# infra-pulse-collector (O-260817-12) — оба необязательны. Без них
# buildMinutesLeft честно остаётся null, сетевой запрос к GitHub не делается.
INFRA_PULSE_GITHUB_TOKEN=""
INFRA_PULSE_GITHUB_ORG=""

# Почта из админки (nodemailer → внешний SMTP). Вход по ссылке идёт НЕ сюда,
# а через локальный контейнер mailer: EMAIL_SERVER_HOST/PORT/FROM выставляет
# сам скрипт выкладки, секретов для входа по ссылке не требуется.
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_USER="noreply@cmpas.ru"
SMTP_PASSWORD="пароль приложения, не пароль от почты"
SMTP_FROM="noreply@cmpas.ru"

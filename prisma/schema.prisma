// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                @id @default(cuid())
  name                  String?
  email                 String                @unique
  emailVerified         DateTime?
  image                 String?
  role                  String                @default("USER")
  isBlocked             Boolean               @default(false)
  accounts              Account[]
  authSessions          Session[]
  // Diary relations
  clients               DiaryClient[]
  diarySessions         DiarySession[]
  availabilitySlots     AvailabilitySlot[]
  timeBlocks            TimeBlock[]
  calendarIntegrations  CalendarIntegration[]
  psychologistSettings  PsychologistSettings?
  notificationSettings  NotificationSettings?
  psychologistAddresses PsychologistAddress[]
  diaryBlocks           DiaryBlock[]
  scheduleRules         ScheduleRule[]

  // Therapy process (Smart Notes)
  therapyGoals      TherapyGoal[]
  homeworks         Homework[]
  clientAssessments ClientAssessment[]

  telegramChatId   String?          @unique
  telegramUsername String?
  telegramClients  TelegramClient[]
  maxChatId        String?          @unique
  fcmToken         String?

  // Trial & Billing
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  subscriptionPlan   String? // 'practice' | 'practice_plus'
  payments           Payment[]
  subscription       Subscription?

  // Legal Documents (152-FZ, Advertising)
  legalAcceptances LegalDocumentAcceptance[]

  // Analytics consent (charter/12_ANALYTICS.md §2) — null means not given.
  // Rule: no device_id is written to analytics events before this is set.
  analyticsConsentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// OWASP Security Logging: Track all authentication events
model AuditLog {
  id        String  @id @default(cuid())
  userId    String? // null for failed attempts
  email     String? // email used in attempt
  action    String // "LOGIN_SUCCESS", "LOGIN_FAILED", "LOGOUT", "OTP_SENT", "OTP_VERIFIED"
  provider  String? // "yandex", "email", null
  ipAddress String?
  userAgent String?
  metadata  String? // JSON string for additional context

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// Legal Documents & Consents
// ============================================

model LegalDocument {
  id          String    @id @default(cuid())
  type        String // "TERMS", "PRIVACY", "ADS"
  version     String // "1.0"
  url         String // Path or URL to the PDF document
  isActive    Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acceptances LegalDocumentAcceptance[]

  @@index([type])
  @@index([isActive])
}

model LegalDocumentAcceptance {
  id              String   @id @default(cuid())
  userId          String
  documentId      String
  acceptedAt      DateTime @default(now())
  ipAddress       String?
  source          String   @default("web") // "web" | "android"
  documentType    String? // snapshot of LegalDocument.type at acceptance time
  documentVersion String? // snapshot of LegalDocument.version at acceptance time

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@index([userId])
  @@index([documentId])
  @@index([userId, source])
  @@index([documentType])
}

// Visitor Analytics for LAL Audience Building
model VisitorAnalytics {
  id                    String    @id @default(cuid())
  visitorId             String    @unique // FingerprintJS visitor ID
  ip                    String?
  // GEO data from IP (enhanced with district)
  country               String?
  countryCode           String?
  city                  String?
  region                String?
  district              String? // Neighborhood/district within city
  postalCode            String?
  lat                   Float?
  lon                   Float?
  timezone              String?
  isp                   String? // Internet Service Provider
  org                   String? // Organization
  asn                   String? // Autonomous System Number
  // Device details (from ua-parser-js)
  userAgent             String?
  deviceType            String? // "mobile", "tablet", "desktop", "console", etc.
  deviceVendor          String? // "Apple", "Samsung", "Huawei", etc.
  deviceModel           String? // "iPhone", "Galaxy S23", etc.
  // Browser details
  browserName           String? // "Chrome", "Safari", "Firefox", etc.
  browserVersion        String? // "120.0.0"
  browserMajor          String? // "120"
  // Engine details
  engineName            String? // "Blink", "WebKit", "Gecko"
  engineVersion         String?
  // OS details
  osName                String? // "Android", "iOS", "Windows", "macOS"
  osVersion             String?
  // CPU architecture
  cpuArchitecture       String? // "amd64", "arm", etc.
  // Screen & hardware
  language              String?
  platform              String?
  screenWidth           Int?
  screenHeight          Int?
  devicePixelRatio      Float?
  touchSupport          Boolean?
  deviceMemory          Float?
  hardwareConcurrency   Int?
  connectionType        String? // "4g", "wifi", etc.
  connectionDownlink    Float? // Mbps
  // Session data
  referrer              String?
  referrerDomain        String? // Extracted domain from referrer
  currentUrl            String?
  pathname              String?
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  utmContent            String?
  utmTerm               String?
  sessionStart          DateTime?
  timestamp             DateTime?
  fingerprintComponents String? // JSON string of all fingerprint components
  visits                Int       @default(1)

  // Связка с аккаунтом (B5, q_sources — funnel.ts): проставляется один раз
  // при входе/регистрации (src/auth.ts), когда становится известно, кем
  // оказался этот отпечаток устройства — задним числом не переписывается
  // (13_TRACKING_PLAN.md §2: "Задним числом идентификаторы не
  // перезаписываются"). Не внешний ключ — тот же выбор, что уже сделан для
  // PageView.visitorId ниже, см. миграцию 20260823100000.
  accountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visitorId])
  @@index([deviceType])
  @@index([country])
  @@index([city])
  @@index([deviceVendor])
  @@index([browserName])
  @@index([osName])
  @@index([utmSource])
  @@index([createdAt])
  @@index([accountId])
}

// Per-hit pageview log (for time-series charts, top pages, etc.)
model PageView {
  id             String   @id @default(cuid())
  visitorId      String // Matches VisitorAnalytics.visitorId (not a FK — visitor may arrive before analytics record is created)
  pathname       String?
  currentUrl     String?
  referrerDomain String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  deviceType     String? // "mobile", "tablet", "desktop"
  country        String?
  city           String?
  isNewVisitor   Boolean  @default(false) // true if this is the first visit for visitorId
  createdAt      DateTime @default(now())

  @@index([visitorId])
  @@index([createdAt])
  @@index([pathname])
  @@index([deviceType])
  @@index([utmSource])
  @@index([country])
}

// Orders from the website
model Order {
  id            String  @id @default(cuid())
  name          String
  phone         String
  contactMethod String // telegram, whatsapp, max
  status        String  @default("NEW") // NEW, CONTACTED, PROCESSING, COMPLETED, CANCELLED
  notes         String?
  // Tracking
  visitorId     String? // Link to VisitorAnalytics
  ipAddress     String?
  userAgent     String?
  // GEO
  country       String?
  city          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([visitorId])
}

// ============================================
// Diary (Psychologist Cabinet) Models
// ============================================

model DiaryClient {
  id              String    @id @default(cuid())
  psychologistId  String
  name            String
  phone           String?
  email           String?
  dateOfBirth     DateTime?
  age             Int?
  gender          String? // male, female, other
  totalSessions   Int       @default(0)
  nextSessionDate DateTime?
  status          String    @default("active") // active, paused, archived

  // Telegram Integration
  telegramChatId String? // For notifications direct to client
  telegramClient TelegramClient?

  // MAX Integration
  maxChatId String? // For MAX messenger notifications

  // Consent (152-FZ)
  consentVersion String? // Version of consent text agreed to
  consentHash    String? // SHA-256: tgUserId + version + timestamp
  consentDate    DateTime? // When consent was given

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  psychologist  User                @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  questionnaire DiaryQuestionnaire?
  sessions      DiarySession[]

  // Therapy process & Smart Notes
  therapyGoals TherapyGoal[]
  homeworks    Homework[]
  risk         ClientRisk?
  assessments  ClientAssessment[]
  checkIns     ClientCheckIn[]

  @@index([psychologistId])
  @@index([status])
}

model DiaryQuestionnaire {
  id          String  @id @default(cuid())
  clientId    String  @unique
  data        Json // All 7 questionnaire sections stored as JSON
  isCompleted Boolean @default(false) // Whether the anamnesis is considered full

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client DiaryClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model DiarySession {
  id              String   @id @default(cuid())
  psychologistId  String
  clientId        String
  date            DateTime
  time            String // "10:00"
  endTime         String? // "10:50"
  duration        Int      @default(50) // minutes
  type            String   @default("individual") // individual, couple, family
  format          String   @default("online") // online, offline
  addressId       String? // nullable reference to a PsychologistAddress
  status          String   @default("pending") // pending, confirmed, completed, cancelled
  notes           String? // Legacy flat notes
  structuredNotes Json? // Array of smart tags/blocks (e.g. Anamnesis, Request)
  privateNotes    Json? // Array of private blocks for the psychologist only
  clientSummary   String? // Text summary to be shown in the client's cabinet

  notified24h        Boolean @default(false)
  notified1h         Boolean @default(false)
  postSessionNudged  Boolean @default(false)
  clientMoodRating   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  psychologist User                 @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  client       DiaryClient          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  address      PsychologistAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  homeworks    Homework[]

  @@index([psychologistId])
  @@index([clientId])
  @@index([date])
  @@index([status])
}

model DiaryBlock {
  id             String   @id @default(cuid())
  psychologistId String
  date           DateTime // Дата блокировки
  startTime      String // "10:00"
  endTime        String // "12:00"
  reason         String? // Причина, например "Отпуск" или "Обед"
  type           String   @default("personal") // В будущем можно делить на 'personal', 'holiday', 'sick_leave'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId])
  @@index([date])
}

model AvailabilitySlot {
  id             String    @id @default(cuid())
  psychologistId String
  dayOfWeek      Int // 0=Mon ... 6=Sun
  startTime      String // "09:00"
  endTime        String // "13:00"
  duration       Int?      @default(50)
  format         String?   @default("online") // online, offline, both
  addressId      String? // nullable reference to a PsychologistAddress
  isRecurring    Boolean   @default(true)
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean   @default(true)
  scheduleRuleId String? // Link to grouping rule (nullable for backward compat)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  psychologist User                 @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  address      PsychologistAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  scheduleRule ScheduleRule?        @relation(fields: [scheduleRuleId], references: [id], onDelete: SetNull)

  @@index([psychologistId])
  @@index([dayOfWeek])
  @@index([scheduleRuleId])
}

// Grouping layer: named schedule rules (e.g. "Main Schedule", "Summer")
model ScheduleRule {
  id             String  @id @default(cuid())
  psychologistId String
  name           String // "Основное расписание", "Летнее"
  priority       Int     @default(0)
  isActive       Boolean @default(true)
  color          String? // Hex color for UI tagging

  // Настройки самого правила (действуют на все слоты)
  format         String    @default("online")
  addressId      String?
  duration       Int       @default(50)
  breakDuration  Int       @default(15)
  audienceFilter String    @default("all") // "all", "new", "regular"
  startDate      DateTime?
  endDate        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  psychologist User               @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  slots        AvailabilitySlot[]

  @@index([psychologistId])
}

model TimeBlock {
  id             String   @id @default(cuid())
  psychologistId String
  startDate      DateTime
  endDate        DateTime
  type           String // vacation, personal, other
  reason         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId])
}

model CalendarIntegration {
  id             String    @id @default(cuid())
  psychologistId String
  provider       String // google, yandex, apple
  accountEmail   String?
  isActive       Boolean   @default(false)
  lastSynced     DateTime?
  conflictsCount Int       @default(0)

  // OAuth tokens (Google Calendar)
  accessToken  String? // encrypted
  refreshToken String? // encrypted
  tokenExpiry  DateTime?

  // CalDAV credentials (Yandex Calendar)
  caldavLogin    String? // encrypted
  caldavPassword String? // encrypted (app password)
  caldavUrl      String? // CalDAV server URL

  // Calendar identifiers
  calendarId String? // provider-specific calendar ID or URL
  syncToken  String? // for incremental sync (ctag/syncToken)

  // Settings for two-way synchronization
  syncFrom Boolean @default(true) // Whether to import events to block diary slots

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@unique([psychologistId, provider])
  @@index([psychologistId])
}

model PsychologistSettings {
  id                     String  @id @default(cuid())
  psychologistId         String  @unique
  fullName               String?
  timezone               String  @default("Europe/Moscow")
  defaultSessionDuration Int     @default(50)
  sessionBreak           Int     @default(15) // Minutes buffer between sessions
  onlineSessionLink      String?
  officeAddress          String?
  cancellationHours      Int     @default(24)
  cancellationFee        Int     @default(50)
  cancellationText       String?
  autoSync               Boolean @default(true)
  blockConflicts         Boolean @default(true)
  scheduleMode           String  @default("private") // private | readonly | booking
  onboardingCompleted    Boolean @default(false)
  maxSessionsPerDay      Int? // Max sessions per day (null = unlimited)
  bookingBufferHours     Int     @default(24) // Запись минимум за N часов
  bookingHorizonDays     Int     @default(14) // Максимальный горизонт записи в днях

  // CJM_booking_v1.md §1.3 "Тихая запись": confirm/cancel links from reminders
  // stop working once the session is over. Off by default — see O-260817-03.
  privateRemindersEnabled Boolean @default(false)
  // CJM_booking_v1.md §1.2 "Подбор времени": a preference question and 2-3
  // suggested slots instead of an empty-looking grid. Off by default.
  timeSuggestEnabled      Boolean @default(false)

  methods   String[] @default([])
  basePrice Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model NotificationSettings {
  id             String @id @default(cuid())
  psychologistId String @unique

  // Для психолога
  newBookingEnabled       Boolean @default(true)
  newBookingTemplate      String  @default("🔥 Новая запись!\n\nКлиент: {clientName}\n📅 {date} в {time}\n📍 {format}")
  reminderEnabled         Boolean @default(true)
  reminderMinutesBefore   Int     @default(60)
  reminderTemplate        String  @default("⏰ Напоминание: сессия через {time} с {clientName}")
  clientRescheduleEnabled Boolean @default(true)
  clientCancelEnabled     Boolean @default(true)

  // Проактивные уведомления психологу
  morningDigestEnabled Boolean @default(true)
  weeklyDigestEnabled  Boolean @default(true)

  // Для клиента
  clientReminder25hEnabled  Boolean @default(true)
  clientReminder25hTemplate String  @default("Напоминаем: завтра у вас сессия с {psyName} в {time}")
  clientReminder1hEnabled   Boolean @default(true)
  clientReminder1hTemplate  String  @default("Через час начнётся ваша сессия с {psyName}")
  clientPsyCancelEnabled    Boolean @default(true)
  clientPsyCancelTemplate   String  @default("К сожалению, специалист отменил сессию {date} в {time}. {cancelLink}")

  // Проактивные уведомления клиенту (контроль психолога)
  clientMoodCheckEnabled Boolean @default(false)

  psychologist User     @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PsychologistAddress {
  id             String @id @default(cuid())
  psychologistId String
  name           String // e.g. "Центр", "Кабинет на Ленина"
  address        String // Actual physical address

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  psychologist      User               @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  availabilitySlots AvailabilitySlot[]
  sessions          DiarySession[]
}

// Telegram Bot specific tables
model TelegramClient {
  id               String    @id @default(cuid())
  telegramUserId   String    @unique
  telegramUsername String?
  phone            String?
  email            String?
  fullName         String?
  consentGiven     Boolean   @default(false)
  consentDate      DateTime?

  // Linking to potential actual entities
  diaryClientId String?      @unique
  diaryClient   DiaryClient? @relation(fields: [diaryClientId], references: [id])

  psychologistId String? // The primary psychologist this client interacts with
  psychologist   User?   @relation(fields: [psychologistId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([psychologistId])
}

// Versioned consent text (152-FZ compliance)
model ConsentVersion {
  id        String   @id @default(cuid())
  version   String   @unique // e.g. "2026-03-07-v1"
  text      String // Full consent text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============================================
// Therapy & Smart Tags Models (Release 1)
// ============================================

model TherapyGoal {
  id             String @id @default(cuid())
  clientId       String
  psychologistId String

  description String // "Запрос" / Goal
  criteria    String? // "Критерии успеха"
  status      String  @default("active") // active, achieved, abandoned

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client       DiaryClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  psychologist User        @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([psychologistId])
}

model Homework {
  id             String  @id @default(cuid())
  clientId       String
  psychologistId String
  sessionId      String? // Which session generated this homework

  title          String
  description    String
  status         String    @default("pending") // pending, completed, cancelled
  dueDate        DateTime?
  clientFeedback String? // Client's input when completing

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client       DiaryClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  psychologist User          @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  session      DiarySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([sessionId])
}

model ClientRisk {
  id       String @id @default(cuid())
  clientId String @unique

  level         String // low, medium, high, critical
  description   String? // Что вызывает опасения
  safetyPlan    String? // План безопасности (что делать клиенту/терапевту)
  nextCheckDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client DiaryClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientAssessment {
  id             String @id @default(cuid())
  clientId       String
  psychologistId String

  toolName       String // Название методики (e.g. "PHQ-9", "GAD-7", "BDI")
  score          Float? // Баллы
  resultText     String? // Интерпретация
  date           DateTime // Дата заполнения
  nextAssessment DateTime? // Когда повторить

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client       DiaryClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  psychologist User        @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([toolName])
}

model ClientCheckIn {
  id       String @id @default(cuid())
  clientId String

  moodRating Int? // e.g. 1-5 or 1-10
  notes      String?
  date       DateTime @default(now())

  createdAt DateTime @default(now())

  client DiaryClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([date])
}

model Payment {
  id               String   @id @default(cuid())
  userId           String
  orderId          String   @unique // our order ID sent to Tinkoff
  tinkoffPaymentId String?  @unique // PaymentId from Tinkoff
  rebillId         String? // RebillId for future recurring charges
  amount           Int // in kopecks
  plan             String // 'practice' | 'practice_plus'
  status           String   @default("pending") // pending | paid | failed | cancelled
  paymentUrl       String? // Tinkoff redirect URL
  months           Int      @default(1)
  terminal         String   @default("site") // "site" | "app" — which TerminalKey processed this payment
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// MRR tracking, separate from individual Payment rows (charter/13_TRACKING_PLAN.md §5).
model Subscription {
  id                String   @id @default(cuid())
  userId            String
  plan              String // 'practice' | 'practice_plus'
  status            String   @default("trial") // trial | active | grace | churned
  terminal          String   @default("site") // "site" | "app"
  startedAt         DateTime @default(now())
  currentPeriodEnd  DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([status])
}

// ── Admin CRM Models ──

model AdminMessage {
  id          String   @id @default(cuid())
  fromAdminId String
  toUserId    String
  channel     String // "telegram" | "max" | "email"
  subject     String?
  content     String
  status      String   @default("sent") // "sent" | "delivered" | "failed"
  errorMsg    String?
  createdAt   DateTime @default(now())

  @@index([toUserId])
  @@index([fromAdminId])
  @@index([createdAt])
}

model AdminActionLog {
  id           String   @id @default(cuid())
  adminId      String
  targetUserId String?
  action       String // "block" | "unblock" | "role_change" | "trial_reset" | "trial_forever" | "test_reset" | "delete" | "message_sent" | "note_added" | "tag_added" | "tag_removed"
  payload      String? // JSON
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@index([targetUserId])
  @@index([createdAt])
}

model UserNote {
  id        String   @id @default(cuid())
  userId    String
  authorId  String
  content   String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model UserTag {
  id        String   @id @default(cuid())
  userId    String
  tag       String
  addedById String
  createdAt DateTime @default(now())

  @@unique([userId, tag])
  @@index([userId])
  @@index([tag])
}

model SystemConfig {
  key       String   @id
  value     String   @default("false")
  label     String   @default("")
  category  String   @default("features")
  updatedAt DateTime @updatedAt
}

// Scheduled (delayed) client messages — set by psychologist to be sent at a future time
model ScheduledClientMessage {
  id             String    @id @default(cuid())
  psychologistId String
  clientId       String
  sessionId      String?
  channel        String    // "telegram" | "max" | "manual"
  text           String
  sendAt         DateTime
  status         String    @default("pending") // "pending" | "sent" | "failed" | "manual_pending"
  sentAt         DateTime?
  errorMsg       String?
  createdAt      DateTime  @default(now())

  @@index([psychologistId])
  @@index([clientId])
  @@index([sendAt])
  @@index([status])
}

// Invite tokens for clients to link their Telegram/MAX account to a client card
model ClientInviteToken {
  id             String    @id @default(cuid())
  psychologistId String
  clientId       String
  token          String    @unique
  channel        String    // "telegram" | "max"
  usedAt         DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  @@index([token])
  @@index([clientId])
}

// Persistent notification feed for the psychologist (Android/web bell icon).
// Written at the moment an event happens, so unread state and history survive
// past the old 7-day rolling window computed on the fly by the dashboard.
model PracticeNotification {
  id             String    @id @default(cuid())
  psychologistId String
  type           String // see NotificationType in src/lib/notifications.ts
  title          String
  subtitle       String?
  sessionId      String?
  clientId       String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([psychologistId, createdAt])
  @@index([psychologistId, readAt])
}

// CJM_booking_v1.md §2 этап 8: capture only, shown when the suggested-times
// screen (Mechanic B) finds nothing. No matching/notification engine yet —
// that's a later mechanic (product/practice/CJM_booking_v1.md §4 "Порядок").
model WaitlistEntry {
  id             String   @id @default(cuid())
  psychologistId String
  name           String
  contact        String
  preference     String? // same preference tag as getSuggestedTimes, if any
  createdAt      DateTime @default(now())

  @@index([psychologistId, createdAt])
}

// ── Analytics ingest (charter/12_ANALYTICS.md, charter/13_TRACKING_PLAN.md §6) ──
// Behind ANALYTICS_INGEST_ENABLED flag, default off. Validated against
// analytics/schema/events.yaml before being written here; anything that fails
// validation goes to AnalyticsEventRejected instead. No free-text fields ever.
model AnalyticsEvent {
  id            String   @id @default(cuid())
  event         String
  ts            DateTime
  product       String
  accountId     String? // null for a device without an account yet (O-260817-13)
  deviceId      String? // null until consent is on file — for the account (analyticsConsentAt) or, absent an account, for the device (AnalyticsDeviceConsent)
  props         Json
  schemaVersion Int
  createdAt     DateTime @default(now())
  // Идемпотентность POST /ingest (O-260817-17) — необязательный конверт-ID
  // от отправителя. Уникален, но nullable: старые/несовместимые клиенты, не
  // присылающие event_id, продолжают писать как раньше — Postgres не
  // считает несколько NULL коллизией уникального индекса.
  eventId       String?  @unique

  @@map("events")
  @@index([event])
  @@index([accountId])
  @@index([ts])
}

model AnalyticsEventRejected {
  id        String   @id @default(cuid())
  reason    String
  payload   Json
  createdAt DateTime @default(now())

  @@map("events_rejected")
  @@index([createdAt])
}

// ── Technical pulse (O-260817-12, TZ_management_dashboard.md §9) ────────────
// One row per collection tick (~every 5 min), written ONLY by the read-only
// infra-pulse-collector container (docker/infra-pulse-role.sh: SELECT-only
// DB role + read-only docker socket + read-only host mounts). Raw readings,
// kept 90 days (collector prunes older rows itself — see
// scripts/infra-pulse-collector.ts). No user identifiers, no paths, no
// secrets, ever — grouped/variable-shape numbers only.
model InfraPulse {
  id          String   @id @default(cuid())
  collectedAt DateTime @default(now())

  // Server — from /proc and a read-only host disk mount, not host-level
  // /proc access is unavailable to a bare docker socket; см. PR notes for
  // the extra read-only mount this requires.
  cpuPercent     Float?
  memUsedBytes   BigInt?
  memTotalBytes  BigInt?
  diskUsedBytes  BigInt?
  diskTotalBytes BigInt?

  // Containers — [{ name, running, uptimeSeconds, restarts24h }]
  containers Json?

  // Database
  dbSizeBytes          BigInt?
  dbTopTables          Json? // [{ name, bytes }] — 5 largest
  dbRowCounts          Json? // { User: n, DiaryClient: n, DiarySession: n, Payment: n }
  migrationsApplied    Int?
  migrationsUnfinished Int?
  migrationsDrift      Json? // { onlyInRepo: [...], onlyInDb: [...] } — migration folder names only

  // Backups — read from the same read-only host mount as disk usage
  // (/var/backups/cmpas, already written by deploy-production-remote.sh
  // and backup-db.yml; no new access category beyond that mount).
  backupAgeHours           Float?
  backupSizeBytes          BigInt?
  backupSizeRatioYesterday Float?
  backupReadable           Boolean?

  // Reminders (O-260817-16) — null until ReminderOutbox exists (that
  // migration may land after this one; collector checks first).
  remindersDue       Int?
  remindersSent      Int?
  remindersSentTwice Int?

  // Certificate — outbound TLS handshake to the public port, no docker
  // socket or DB access needed for this one.
  certDaysLeft        Int?
  certDaysLeftZapiski Int?

  // Channels & build budget (TZ_ADMIN_PANEL_DEV.md §6.1) — three strictly
  // additive columns. All nullable: a collector that predates this migration
  // simply leaves them null, and the panel renders those blocks as no_data
  // rather than as zero.
  // { payments: { rate, checkedAt, sampleSize } } — доля платежей Т-Банка со
  // статусом 'failed' за сутки. Изначально задумывался как доля ошибок
  // именно Telegram/MAX ботов (см. историю), но их доставка нигде не
  // журналируется; см. src/lib/infra-pulse/webhook-error-rate.ts за полным
  // обоснованием честной замены источника.
  webhookErrorRates Json?
  buildMinutesLeft  Int? // remaining GitHub Actions minutes
  infraCostRub      Json? // { server, storage, domains, total, source: 'manual'|'api' }

  // Ответ приложения (q_tech_response_p95, ТЗ §5) — переносится из
  // AppResponseTime, см. комментарий там же.
  responseP95Ms Int?

  @@index([collectedAt])
}

// Deploy history (O-260817-12, "выкладки" card). NOT written by the
// read-only collector — deploy-production-remote.sh already has DB write
// access during a deploy (it applies migrations), so it is the one
// instrumented to insert a row at each of its own decision points. The
// collector only ever SELECTs from this table, same as everything else.
model DeployLog {
  id         String    @id
  startedAt  DateTime
  finishedAt DateTime?
  result     String // "success" | "rolled_back" | "schema_guard_stopped" | "failed"
  imageRef   String?
  errorNote  String?

  @@index([startedAt])
  @@index([result])
}

// Consent basis for a device that has no account (O-260817-13): МОМЕНТЫ has
// none at all, ЗАПИСКИ has no production login yet. Independent of
// User.analyticsConsentAt — an account's consent doesn't retroactively cover
// events the same device sent before the account existed, and vice versa.
model AnalyticsDeviceConsent {
  deviceId  String    @id
  consentAt DateTime?
  updatedAt DateTime  @updatedAt

  @@map("analytics_device_consent")
}

// Журнал фактических отправок напоминаний (O-260817-16). До этой модели
// таблица не существовала: src/lib/infra-pulse/reminders-counters.ts уже
// проверял её наличие через to_regclass('public."ReminderOutbox"') и отдавал
// null, пока её нет — карточка «Рассылка» панели молчала как no_data не
// потому, что коллектор не умел её читать, а потому, что писать в неё было
// некому.
//
// Пишет processReminders() (src/lib/cron/reminders.ts) — в момент
// фактической попытки отправки, а не заранее по расписанию: у ПРАКТИКИ нет
// отдельного шага планирования напоминаний, cron каждые 15 минут сам
// опрашивает DiarySession и шлёт то, что попало в 24-часовое/часовое окно.
// Поэтому `dueAt` здесь — теоретический момент, когда напоминание должно
// было уйти (время сессии минус 24ч/1ч), а не отдельно запланированная
// метка; на практике он почти совпадает с `sentAt`, и это честно отражает
// нынешнюю архитектуру, а не выдуманное планирование.
//
// Уникальность по (sessionId, type, channel) — не по id: повторный проход
// cron по той же сессии и тому же каналу обновляет ту же строку и
// увеличивает sendCount, а не плодит дубли; sendCount > 1 — это и есть
// «отправлено дважды», карточка панели уже считает его так
// (reminders-counters.ts: `sent_twice`).
model ReminderOutbox {
  id        String    @id @default(cuid())
  type      String // 'session_24h_client' | 'session_24h_psychologist' | 'session_1h_client'
  channel   String // 'telegram' | 'max'
  recipient String // chat id получателя в этом канале
  sessionId String? // DiarySession.id, если напоминание привязано к сессии
  dueAt     DateTime // теоретический момент, когда напоминание должно было уйти
  sentAt    DateTime? // когда фактически ушло; null, если последняя попытка не удалась
  status    String    @default("pending") // 'pending' | 'sent' | 'error'
  error     String?
  sendCount Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([sessionId, type, channel])
  @@index([dueAt])
  @@index([status])
}

// Время ответа приложения (q_tech_response_p95, ТЗ §5, экран 6). Пишет сам
// процесс Next.js через middleware.ts — у него уже есть полная запись, в
// отличие от read-only коллектора, — а не infra-pulse-collector: тот только
// читает эту таблицу, как он уже читает DeployLog и Payment, и переносит
// последний p95 в свой снимок (src/lib/infra-pulse/response-time.ts). Это
// сохраняет инвариант "InfraPulse пишет только коллектор" нетронутым.
//
// Одна строка на окно (~5 минут), не строка на запрос — middleware
// накапливает длительности в памяти процесса
// (src/lib/infra-pulse/response-time.ts, defaultDurationStore) и сбрасывает
// агрегатом по расписанию (src/instrumentation.ts), тем же приёмом, что и
// остальные cron-задачи в этом файле. Никакого внешнего APM.
model AppResponseTime {
  id          String   @id @default(cuid())
  windowStart DateTime
  windowEnd   DateTime
  sampleCount Int
  p50Ms       Int?
  p95Ms       Int?
  p99Ms       Int?
  createdAt   DateTime @default(now())

  @@index([windowEnd])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  name                   String?
  email                  String?   @unique
  emailVerified          DateTime?
  image                  String?
  role                   String    @default("PSYCHOLOGIST")
  isBlocked              Boolean   @default(false)
  trialEndsAt            DateTime?
  subscriptionEndsAt     DateTime?
  subscriptionPlan       String?
  telegramChatId         String?   @unique
  telegramUsername       String?
  maxChatId              String?   @unique
  fcmToken               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  accounts               Account[]
  sessions               Session[]
  diaryClients           DiaryClient[]
  diarySessions          DiarySession[]
  diaryBlocks            DiaryBlock[]
  availabilitySlots      AvailabilitySlot[]
  psychologistSettings   PsychologistSettings?
  scheduleRules          ScheduleRule[]
  calendarIntegrations   CalendarIntegration[]
  notificationSettings   NotificationSettings?
  addresses              PsychologistAddress[]
  homeworks              Homework[]
  homeworkTemplates      HomeworkTemplate[]
  recurringSeries        RecurringSessionSeries[]

  @@index([role])
  @@index([isBlocked])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DiaryClient {
  id             String   @id @default(cuid())
  psychologistId String
  name           String
  email          String?
  phone          String?
  gender         String?
  status         String   @default("active")
  telegramChatId String?
  maxChatId      String?
  notes          String?
  consentDate    DateTime?
  consentVersion String?
  consentHash    String?
  totalSessions  Int      @default(0)
  nextSessionDate DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  sessions     DiarySession[]
  questionnaire ClientQuestionnaire?
  moodCheckIns ClientMoodCheckIn[]
  homeworks    Homework[]

  @@index([psychologistId])
  @@index([status])
  @@index([telegramChatId])
  @@index([maxChatId])
}

model ClientQuestionnaire {
  id        String   @id @default(cuid())
  clientId  String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client DiaryClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientMoodCheckIn {
  id        String   @id @default(cuid())
  clientId  String
  sessionId String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  client DiaryClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model DiarySession {
  id              String   @id @default(cuid())
  psychologistId  String
  clientId        String
  date            DateTime
  time            String
  endTime         String?
  duration        Int      @default(50)
  type            String   @default("individual")
  format          String   @default("online")
  addressId       String?
  status          String   @default("pending")
  paymentStatus   String   @default("not_required")
  notes           String?
  structuredNotes Json?
  privateNotes    Json?
  clientSummary   String?

  notified24h        Boolean @default(false)
  notified1h         Boolean @default(false)
  postSessionNudged  Boolean @default(false)
  clientMoodRating   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  psychologist User                 @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  client       DiaryClient          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  address      PsychologistAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  homeworks    Homework[]

  @@index([psychologistId])
  @@index([clientId])
  @@index([date])
  @@index([status])
  @@index([paymentStatus])
}

model DiaryBlock {
  id             String   @id @default(cuid())
  psychologistId String
  date           DateTime
  startTime      String
  endTime        String
  reason         String?
  type           String   @default("personal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId])
  @@index([date])
}

model AvailabilitySlot {
  id             String   @id @default(cuid())
  psychologistId String
  dayOfWeek      Int
  startTime      String
  endTime        String
  duration       Int?
  format         String?
  addressId      String?
  isActive       Boolean  @default(true)
  startDate      DateTime?
  endDate        DateTime?
  scheduleRuleId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  address      PsychologistAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  scheduleRule ScheduleRule? @relation(fields: [scheduleRuleId], references: [id], onDelete: SetNull)

  @@index([psychologistId])
  @@index([scheduleRuleId])
}

model PsychologistAddress {
  id             String   @id @default(cuid())
  psychologistId String
  name           String
  address        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  availabilitySlots AvailabilitySlot[]
  sessions DiarySession[]

  @@index([psychologistId])
}

model ScheduleRule {
  id             String   @id @default(cuid())
  psychologistId String
  name           String
  priority       Int      @default(0)
  isActive       Boolean  @default(true)
  color          String?
  format         String   @default("online")
  addressId      String?
  duration       Int      @default(50)
  breakDuration  Int      @default(15)
  audienceFilter String   @default("all")
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  availabilitySlots AvailabilitySlot[]

  @@index([psychologistId])
}

model PsychologistSettings {
  id                 String   @id @default(cuid())
  psychologistId     String   @unique
  fullName           String?
  publicName         String?
  specialization     String?
  description        String?
  methods            String[] @default([])
  basePrice          Int?
  scheduleMode       String   @default("private")
  onlineSessionLink  String?
  sessionBreak       Int      @default(15)
  bookingBufferHours Int      @default(24)
  bookingHorizonDays Int      @default(14)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model NotificationSettings {
  id                         String   @id @default(cuid())
  psychologistId             String   @unique
  newBookingEnabled          Boolean  @default(true)
  newBookingTemplate         String   @default("")
  reminderEnabled            Boolean  @default(true)
  reminderMinutesBefore      Int      @default(60)
  reminderTemplate           String   @default("")
  clientRescheduleEnabled    Boolean  @default(true)
  clientCancelEnabled        Boolean  @default(true)
  clientReminder25hEnabled   Boolean  @default(true)
  clientReminder25hTemplate  String   @default("")
  clientReminder1hEnabled    Boolean  @default(true)
  clientReminder1hTemplate   String   @default("")
  clientPsyCancelEnabled     Boolean  @default(true)
  clientPsyCancelTemplate    String   @default("")
  morningDigestEnabled       Boolean  @default(true)
  weeklyDigestEnabled        Boolean  @default(true)
  clientMoodCheckEnabled     Boolean  @default(false)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
}

model Payment {
  id               String   @id @default(cuid())
  userId           String
  orderId          String   @unique
  tinkoffPaymentId String?  @unique
  rebillId         String?
  amount           Int
  plan             String
  status           String   @default("pending")
  paymentUrl       String?
  months           Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model CalendarIntegration {
  id             String   @id @default(cuid())
  psychologistId String
  provider       String
  accountEmail   String
  accessToken    String
  refreshToken   String?
  calendarId     String?
  syncFrom       Boolean  @default(true)
  syncTo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  @@index([psychologistId])
}

model Homework {
  id             String   @id @default(cuid())
  psychologistId String
  clientId       String
  sessionId      String?
  title          String
  description    String?
  status         String   @default("assigned")
  clientFeedback String?
  dueDate        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  client       DiaryClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  session      DiarySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([psychologistId])
  @@index([clientId])
  @@index([sessionId])
}

model HomeworkTemplate {
  id             String   @id @default(cuid())
  psychologistId String
  title          String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  @@index([psychologistId])
}

model RecurringSessionSeries {
  id             String   @id @default(cuid())
  psychologistId String
  clientId       String
  startDate      DateTime
  endDate        DateTime?
  frequency      String
  interval       Int      @default(1)
  byWeekday      Int[]    @default([])
  byMonthDay     Int?
  time           String
  duration       Int      @default(50)
  type           String   @default("individual")
  format         String   @default("online")
  status         String   @default("active")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  @@index([psychologistId])
  @@index([clientId])
}

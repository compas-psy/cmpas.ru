// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                @id @default(cuid())
  name                  String?
  email                 String                @unique
  emailVerified         DateTime?
  image                 String?
  role                  String                @default("USER")
  isBlocked             Boolean               @default(false)
  accounts              Account[]
  authSessions          Session[]
  // Diary relations
  clients               DiaryClient[]
  diarySessions         DiarySession[]
  availabilitySlots     AvailabilitySlot[]
  timeBlocks            TimeBlock[]
  calendarIntegrations  CalendarIntegration[]
  psychologistSettings  PsychologistSettings?
  notificationSettings  NotificationSettings?
  psychologistAddresses PsychologistAddress[]
  diaryBlocks           DiaryBlock[]
  scheduleRules         ScheduleRule[]
  slugs                 PsychologistSlug[]
  practiceImportBatches PracticeImportBatch[]

  // Therapy process (Smart Notes)
  therapyGoals      TherapyGoal[]
  homeworks         Homework[]
  clientAssessments ClientAssessment[]

  telegramChatId   String?          @unique
  telegramUsername String?
  telegramClients  TelegramClient[]
  maxChatId        String?          @unique
  fcmToken         String?

  // Trial & Billing
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  subscriptionPlan   String? // 'practice' | 'practice_plus'
  payments           Payment[]
  subscription       Subscription?

  // Legal Documents (152-FZ, Advertising)
  legalAcceptances LegalDocumentAcceptance[]

  // Task 5: operator attestation + immutable marketing consent history
  practiceOperatorAttestations PracticeOperatorAttestation[]
  consentEvents                ConsentEvent[]

  // Analytics consent (charter/12_ANALYTICS.md §2) — null means not given.
  // Rule: no device_id is written to analytics events before this is set.
  analyticsConsentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// OWASP Security Logging: Track all authentication events
model AuditLog {
  id        String  @id @default(cuid())
  userId    String? // null for failed attempts
  email     String? // email used in attempt
  action    String // "LOGIN_SUCCESS", "LOGIN_FAILED", "LOGOUT", "OTP_SENT", "OTP_VERIFIED"
  provider  String? // "yandex", "email", null
  ipAddress String?
  userAgent String?
  metadata  String? // JSON string for additional context

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// Legal Documents & Consents
// ============================================

model LegalDocument {
  id          String    @id @default(cuid())
  type        String // "TERMS", "PRIVACY", "ADS", "PROFESSIONAL", "PRACTICE"
  // Canonical document code (cmpas_terms, cmpas_privacy, cmpas_professional,
  // cmpas_practice_terms, cmpas_marketing_consent) — see src/lib/legal-documents.ts
  // LEGAL_CODES. `type` stays for existing admin filtering; `code` is the
  // identifier new logic should key off, so it isn't tied to a fixed
  // TERMS/PRIVACY-only assumption.
  code        String?
  version     String // "1.0"
  url         String // Path or URL to the PDF document
  isActive    Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acceptances LegalDocumentAcceptance[]

  @@index([type])
  @@index([isActive])
  @@index([code])
}

model LegalDocumentAcceptance {
  id              String   @id @default(cuid())
  userId          String
  documentId      String
  acceptedAt      DateTime @default(now())
  ipAddress       String?
  source          String   @default("web") // "web" | "android"
  documentType    String? // snapshot of LegalDocument.type at acceptance time
  documentVersion String? // snapshot of LegalDocument.version at acceptance time
  documentCode    String? // snapshot of LegalDocument.code at acceptance time

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: this row is consent evidence. Deleting the
  // LegalDocument it points to must never silently take the evidence with
  // it — src/app/admin/(chrome)/legal/actions.ts#deleteLegalDoc must refuse
  // instead.
  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([userId, documentId])
  @@index([userId])
  @@index([documentId])
  @@index([userId, source])
  @@index([documentType])
  @@index([documentCode])
}

// Task 5 (PRAKTIKA MVP): the psychologist's legal attestation that they are
// the operator of their clients' personal data and have lawful grounds to
// process/share it with PRAKTIKA for processing on their behalf. This is
// NOT the psychologist's own consent to anything — it's a one-time
// attestation gating the *next* client create/import/booking-activation,
// never re-asked unless the wording itself changes version.
model PracticeOperatorAttestation {
  id              String   @id @default(cuid())
  psychologistId  String
  attestationCode String // e.g. "practice_client_data_operator"
  wordingVersion  String
  serviceId       String   @default("practice")
  confirmedAt     DateTime @default(now())
  sourceEvent     String? // what UI/API path triggered the attestation

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@unique([psychologistId, attestationCode, wordingVersion])
  @@index([psychologistId])
}

// Task 5: marketing consent as an append-only history — grant/revoke are
// each their own immutable row. Never delete or update a row: revoking
// consent writes a new 'revoked' event, it does not erase the earlier
// 'granted' one. Effective state is derived from the latest event per
// (userId, channel).
model ConsentEvent {
  id              String   @id @default(cuid())
  userId          String
  consentType     String // "marketing"
  scope           String   @default("cmpas_own_services")
  channel         String // "email" | "push" | "messenger" | "sms" | "all"
  status          String // "granted" | "revoked"
  documentVersion String?
  occurredAt      DateTime @default(now())
  sourceEvent     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, channel])
  @@index([userId, consentType, occurredAt])
}

// Visitor Analytics for LAL Audience Building
model VisitorAnalytics {
  id                    String    @id @default(cuid())
  visitorId             String    @unique // FingerprintJS visitor ID
  ip                    String?
  // GEO data from IP (enhanced with district)
  country               String?
  countryCode           String?
  city                  String?
  region                String?
  district              String? // Neighborhood/district within city
  postalCode            String?
  lat                   Float?
  lon                   Float?
  timezone              String?
  isp                   String? // Internet Service Provider
  org                   String? // Organization
  asn                   String? // Autonomous System Number
  // Device details (from ua-parser-js)
  userAgent             String?
  deviceType            String? // "mobile", "tablet", "desktop", "console", etc.
  deviceVendor          String? // "Apple", "Samsung", "Huawei", etc.
  deviceModel           String? // "iPhone", "Galaxy S23", etc.
  // Browser details
  browserName           String? // "Chrome", "Safari", "Firefox", etc.
  browserVersion        String? // "120.0.0"
  browserMajor          String? // "120"
  // Engine details
  engineName            String? // "Blink", "WebKit", "Gecko"
  engineVersion         String?
  // OS details
  osName                String? // "Android", "iOS", "Windows", "macOS"
  osVersion             String?
  // CPU architecture
  cpuArchitecture       String? // "amd64", "arm", etc.
  // Screen & hardware
  language              String?
  platform              String?
  screenWidth           Int?
  screenHeight          Int?
  devicePixelRatio      Float?
  touchSupport          Boolean?
  deviceMemory          Float?
  hardwareConcurrency   Int?
  connectionType        String? // "4g", "wifi", etc.
  connectionDownlink    Float? // Mbps
  // Session data
  referrer              String?
  referrerDomain        String? // Extracted domain from referrer
  currentUrl            String?
  pathname              String?
  utmSource             String?
  utmMedium             String?
  utmCampaign           String?
  utmContent            String?
  utmTerm               String?
  sessionStart          DateTime?
  timestamp             DateTime?
  fingerprintComponents String? // JSON string of all fingerprint components
  visits                Int       @default(1)

  // Связка с аккаунтом (B5, q_sources — funnel.ts): проставляется один раз
  // при входе/регистрации (src/auth.ts), когда становится известно, кем
  // оказался этот отпечаток устройства — задним числом не переписывается
  // (13_TRACKING_PLAN.md §2: "Задним числом идентификаторы не
  // перезаписываются"). Не внешний ключ — тот же выбор, что уже сделан для
  // PageView.visitorId ниже, см. миграцию 20260823100000.
  accountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visitorId])
  @@index([deviceType])
  @@index([country])
  @@index([city])
  @@index([deviceVendor])
  @@index([browserName])
  @@index([osName])
  @@index([utmSource])
  @@index([createdAt])
  @@index([accountId])
}

// Per-hit pageview log (for time-series charts, top pages, etc.)
model PageView {
  id             String   @id @default(cuid())
  visitorId      String // Matches VisitorAnalytics.visitorId (not a FK — visitor may arrive before analytics record is created)
  pathname       String?
  currentUrl     String?
  referrerDomain String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  deviceType     String? // "mobile", "tablet", "desktop"
  country        String?
  city           String?
  isNewVisitor   Boolean  @default(false) // true if this is the first visit for visitorId
  createdAt      DateTime @default(now())

  @@index([visitorId])
  @@index([createdAt])
  @@index([pathname])
  @@index([deviceType])
  @@index([utmSource])
  @@index([country])
}

// Orders from the website
model Order {
  id            String  @id @default(cuid())
  name          String
  phone         String
  contactMethod String // telegram, whatsapp, max
  status        String  @default("NEW") // NEW, CONTACTED, PROCESSING, COMPLETED, CANCELLED
  notes         String?
  // Tracking
  visitorId     String? // Link to VisitorAnalytics
  ipAddress     String?
  userAgent     String?
  // GEO
  country       String?
  city          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([visitorId])
}

// ============================================
// Diary (Psychologist Cabinet) Models
// ============================================

model DiaryClient {
  id              String    @id @default(cuid())
  psychologistId  String
  name            String
  phone           String?
  email           String?
  dateOfBirth     DateTime?
  age             Int?
  gender          String? // male, female, other
  totalSessions   Int       @default(0)
  nextSessionDate DateTime?
  status          String    @default("active") // active, paused, archived

  // Telegram Integration
  telegramChatId String? // For notifications direct to client
  telegramClient TelegramClient?

  // MAX Integration
  maxChatId String? // For MAX messenger notifications

  // Consent (152-FZ)
  consentVersion String? // Version of consent text agreed to
  consentHash    String? // SHA-256: tgUserId + version + timestamp
  consentDate    DateTime? // When consent was given

  // Ключ идемпотентности с устройства — см. DiarySession.clientRequestId.
  clientRequestId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  psychologist  User                @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  questionnaire DiaryQuestionnaire?
  sessions      DiarySession[]

  // Therapy process & Smart Notes
  therapyGoals TherapyGoal[]
  homeworks    Homework[]
  risk         ClientRisk?
  assessments  ClientAssessment[]
  checkIns     ClientCheckIn[]

  @@index([psychologistId])
  @@index([status])
}

model DiaryQuestionnaire {
  id          String  @id @default(cuid())
  clientId    String  @unique
  data        Json // All 7 questionnaire sections stored as JSON
  isCompleted Boolean @default(false) // Whether the anamnesis is considered full

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client DiaryClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model DiarySession {
  id                         String   @id @default(cuid())
  psychologistId             String
  clientId                   String
  date                       DateTime
  time                       String // "10:00"
  endTime                    String? // "10:50"
  duration                   Int      @default(50) // minutes
  type                       String   @default("individual") // individual, couple, family
  format                     String   @default("online") // online, offline
  addressId                  String? // nullable reference to a PsychologistAddress
  status                     String   @default("pending") // pending, confirmed, completed, cancelled, no_show
  // Task 7/9 (founder review, 2026-09-03): who/what created this row —
  // provenance/audit, NOT a communication-policy switch. Canonical values:
  // 'manual' (psychologist, web/Android) | 'self_booking' (client through
  // the public booking page) | 'calendar_import' (Google/Yandex, Tasks
  // 10-12) | 'spreadsheet_import' (CSV/XLSX, Task 13). Existing rows default
  // to 'manual'. Never branch cron/notification behavior on this field
  // directly — see clientNotificationsEnabled below, which is the actual
  // communication-policy field. origin stays useful for analytics/UI
  // ("where did this session come from") independently of whether client
  // messaging is currently allowed for it.
  origin                     String   @default("manual")
  // Task 9 (founder review): whether AUTOMATED CLIENT-facing messaging
  // (reminders, mood-check, rebooking/weekly-followup nudges) may fire for
  // this session — deliberately a separate field from origin, not derived
  // from it: a session's provenance shouldn't hard-wire its notification
  // policy, since re-enabling notifications later (a psychologist choice)
  // must work without needing to lie about how the session was created.
  // Existing sessions and every manual/self_booking session default to
  // true (nothing changes for the current product). Calendar/CSV import
  // (Tasks 10-13) is required to explicitly pass false when creating rows —
  // the client never went through our booking flow for those.
  clientNotificationsEnabled Boolean  @default(true)
  notes                      String? // Legacy flat notes
  structuredNotes            Json? // Array of smart tags/blocks (e.g. Anamnesis, Request)
  privateNotes               Json? // Array of private blocks for the psychologist only
  clientSummary              String? // Text summary to be shown in the client's cabinet

  notified24h       Boolean @default(false)
  notified1h        Boolean @default(false)
  postSessionNudged Boolean @default(false)
  clientMoodRating  Int?

  // O-260829 §5.4: пост-сессионный каскад — вечерняя отметка специалиста
  // "была/не пришёл" пишется ПРЯМО в status ('completed' | 'no_show'), а не в
  // отдельное поле outcome. Первая версия этой миграции завела отдельные
  // outcome/outcomeMarkedAt, решив, что "проведена/не пришёл" — факт вечерней
  // отметки, отдельный от самой записи. Дополняющее Android-ТЗ (O-260829,
  // android_booking_v2.md §1) проверило код мобильного приложения и
  // показало: рабочий контракт уже наполовину существует — Android-й
  // SessionStatus уже объявляет NO_SHOW как значение статуса,
  // UpdateSessionRequest уже умеет его отправлять, серверный обработчик
  // /api/mobile/sessions/[id] уже принимает любую строку статуса без
  // валидации. Заводить второе, отдельное представление того же факта было
  // бы двоевластием: web писал бы в outcome, Android — в status, и это два
  // разных источника правды для одного и того же "была/не пришёл". Отдельного
  // outcomeMarkedAt тоже не нужно — момент отметки уже есть в обычном
  // updatedAt записи.
  //
  // 'completed' для этого поля не новый — settlePastSessionsForPsychologist
  // (src/lib/session-maintenance.ts) уже переводит сюда сессии автоматически
  // через 15 минут после конца (вызывается с мобильных эндпоинтов). Явная
  // отметка специалиста (веб или Android) просто перезаписывает то же поле —
  // либо подтверждая автоматическое предположение, либо поправляя его на
  // no_show. 'no_show' — единственное по-настоящему новое значение status.
  nextBookingNudgeSent Boolean @default(false)
  weeklyFollowupSent   Boolean @default(false)

  // Ключ идемпотентности, рождённый на устройстве в момент постановки записи в
  // очередь досылки — не в момент отправки. Приложение может потерять ответ
  // сервера (сеть отвалилась после того, как запрос уже обработан) и повторить
  // запрос; без этого ключа повтор создаёт вторую сессию, и специалист видит
  // дубль в расписании. Тот же приём, что event_id у POST /ingest.
  //
  // Nullable: веб и старые версии приложения ключа не присылают вовсе, и это
  // законно. @unique на nullable-колонке в PostgreSQL не мешает множеству NULL.
  clientRequestId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  psychologist        User                 @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  client              DiaryClient          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  address             PsychologistAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  homeworks           Homework[]
  calendarSessionLink CalendarSessionLink?

  @@index([psychologistId])
  @@index([clientId])
  @@index([date])
  @@index([status])
}

model DiaryBlock {
  id             String   @id @default(cuid())
  psychologistId String
  date           DateTime // Дата блокировки
  startTime      String // "10:00"
  endTime        String // "12:00"
  reason         String? // Причина, например "Отпуск" или "Обед"
  type           String   @default("personal") // В будущем можно делить на 'personal', 'holiday', 'sick_leave'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId])
  @@index([date])
}

model AvailabilitySlot {
  id             String    @id @default(cuid())
  psychologistId String
  dayOfWeek      Int // 0=Mon ... 6=Sun
  startTime      String // "09:00"
  endTime        String // "13:00"
  duration       Int?      @default(50)
  format         String?   @default("online") // online, offline, both
  addressId      String? // nullable reference to a PsychologistAddress
  isRecurring    Boolean   @default(true)
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean   @default(true)
  scheduleRuleId String? // Link to grouping rule (nullable for backward compat)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  psychologist User                 @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  address      PsychologistAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  scheduleRule ScheduleRule?        @relation(fields: [scheduleRuleId], references: [id], onDelete: SetNull)

  @@index([psychologistId])
  @@index([dayOfWeek])
  @@index([scheduleRuleId])
}

// Grouping layer: named schedule rules (e.g. "Main Schedule", "Summer")
model ScheduleRule {
  id             String  @id @default(cuid())
  psychologistId String
  name           String // "Основное расписание", "Летнее"
  priority       Int     @default(0)
  isActive       Boolean @default(true)
  color          String? // Hex color for UI tagging

  // Настройки самого правила (действуют на все слоты)
  format         String    @default("online")
  addressId      String?
  duration       Int       @default(50)
  breakDuration  Int       @default(15)
  audienceFilter String    @default("all") // "all", "new", "regular"
  startDate      DateTime?
  endDate        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  psychologist User               @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  slots        AvailabilitySlot[]

  @@index([psychologistId])
}

model TimeBlock {
  id             String   @id @default(cuid())
  psychologistId String
  startDate      DateTime
  endDate        DateTime
  type           String // vacation, personal, other
  reason         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId])
}

model CalendarIntegration {
  id             String    @id @default(cuid())
  psychologistId String
  provider       String // google, yandex, apple
  accountEmail   String?
  isActive       Boolean   @default(false)
  lastSynced     DateTime?
  conflictsCount Int       @default(0)

  // OAuth tokens (Google Calendar)
  accessToken  String? // encrypted
  refreshToken String? // encrypted
  tokenExpiry  DateTime?

  // CalDAV credentials (Yandex Calendar)
  caldavLogin    String? // encrypted
  caldavPassword String? // encrypted (app password)
  caldavUrl      String? // CalDAV server URL

  // Calendar identifiers
  calendarId String? // provider-specific calendar ID or URL
  syncToken  String? // for incremental sync (ctag/syncToken)

  // Settings for two-way synchronization
  syncFrom Boolean @default(true) // Whether to import events to block diary slots

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  psychologist         User                  @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  calendarSessionLinks CalendarSessionLink[]

  @@unique([psychologistId, provider])
  @@index([psychologistId])
}

// Task 12 (PRAKTIKA MVP): the durable link between one imported/synced
// DiarySession and the external calendar event it came from. Two jobs:
//   1. Idempotency for commitPracticeImport — @@unique([integrationId,
//      externalEventId]) means a second attempt to import the SAME external
//      event (a re-run of a stale batch, two browser tabs, a retried
//      request) fails at the database, not at an in-app heuristic. The old
//      preview (date, time, client name) duplicate check was a best-effort
//      guess; this is the real identity.
//   2. The foundation auto-sync.ts's Task-8-era comment already describes:
//      once every synced/imported session has a link, reschedule can update
//      the LINKED external event in place instead of delete+recreate, and
//      external-busy can exclude a session's own linked event from blocking
//      itself. Neither is implemented yet — Task 12 only introduces the
//      model and populates it from import; wiring reschedule/external-busy
//      to use it is separate, deliberately not bundled in here.
// sessionId is @unique: a DiarySession maps to at most one external event.
model CalendarSessionLink {
  id               String   @id @default(cuid())
  psychologistId   String
  sessionId        String   @unique
  integrationId    String
  provider         String
  externalEventId  String
  externalSeriesId String?
  createdAt        DateTime @default(now())

  session     DiarySession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  integration CalendarIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, externalEventId])
  @@index([psychologistId])
}

// Task 12: a durable record of one calendar-import commit attempt — the
// "evidence" the founder asked for. Previously /apply ran its per-item loop
// against whatever the browser happened to POST, with no server-side record
// of what was decided or what happened to each item; a failed request left
// no trace to debug. Now every commit first persists its items (as
// submitted — the resolution the psychologist made in the preview UI),
// THEN commitPracticeImport(batchId) processes them inside one transaction
// and writes each item's outcome back, so any commit (successful, partially
// failed, or fully rolled back) has a queryable record afterward.
model PracticeImportBatch {
  id             String    @id @default(cuid())
  psychologistId String
  status         String    @default("pending") // pending, committed, failed
  imported       Int       @default(0)
  skipped        Int       @default(0)
  failed         Int       @default(0)
